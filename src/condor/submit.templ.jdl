#!/usr/bin/env condor_submit

executable              = $dir/${prefix}_$jobid.sh
should_transfer_files   = YES
when_to_transfer_output = ON_EXIT_OR_EVICT
request_memory          = 4500
use_x509userproxy       = true
x509userproxy           = $proxy
+JobFlavour             = "tomorrow"

output                  = /dev/null
error                   = /dev/null
log                     = /dev/null

+SingularityImage = "/cvmfs/unpacked.cern.ch/registry.hub.docker.com/coffeateam/coffea-dask:latest-py3.8"

Queue 1
